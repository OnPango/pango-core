# Supabase: Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase: Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

ERP_PORT=3000
AI_PORT=8000

# Auth: HS256 secret for access tokens, at least 32 characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=""
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Session cookies (HttpOnly, SameSite=Lax). Secure defaults to true only when NODE_ENV=production.
COOKIE_SECURE=false
# Cookie Domain; production: .onpango.com. Leave empty in development (host-only cookies)
COOKIE_DOMAIN=""
INVITATION_TTL_HOURS=72
EMAIL_VERIFICATION_TTL_HOURS=24

# Organizations are served from <subdomain>.APP_BASE_DOMAIN (also enables CORS for those origins).
# Production: onpango.com
APP_BASE_DOMAIN=localhost
# Frontend URL of an organization, used in invitation and confirmation links. Production: "https://{subdomain}.onpango.com"
WEB_APP_URL_TEMPLATE="http://{subdomain}.localhost:5173"

# Swagger UI at /docs (JSON at /docs-json). On by default except when NODE_ENV=production
SWAGGER_ENABLED=true

# Email (Resend). Without RESEND_API_KEY emails are only logged (not allowed in production).
# Production sender must use the verified domain, e.g. "Pango <no-reply@onpango.com>"
RESEND_API_KEY=""
MAIL_FROM="Pango <onboarding@resend.dev>"
