// Control plane (`public` schema): organizations, accounts, organization members and plans.
// Shared by every organization. See docs/database.md.

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma/control"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CANCELLED

  @@map("organization_status")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED

  @@map("subscription_status")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED

  @@map("membership_status")
}

enum BusinessSector {
  RETAIL
  WHOLESALE
  MANUFACTURING
  FOOD_AND_BEVERAGE
  PHARMACY_AND_HEALTH
  HARDWARE_AND_CONSTRUCTION
  FASHION_AND_APPAREL
  TECHNOLOGY
  AGRICULTURE
  SERVICES
  OTHER

  @@map("business_sector")
}

/// Number of people on the organization's team, as a range.
enum TeamSize {
  SIZE_1_5
  SIZE_6_20
  SIZE_21_50
  SIZE_51_200
  SIZE_201_PLUS

  @@map("team_size")
}

/// Number of products the organization manages, as a range.
enum ProductCount {
  COUNT_1_100
  COUNT_101_500
  COUNT_501_2000
  COUNT_2001_10000
  COUNT_10001_PLUS

  @@map("product_count")
}

/// Commercial plan with the limits it grants.
model Plan {
  id            Int      @id @default(autoincrement())
  name          String   @unique @db.VarChar(60)
  maxUsers      Int      @map("max_users")
  maxWarehouses Int      @map("max_warehouses")
  monthlyPrice  Decimal  @map("monthly_price") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions Subscription[]

  @@map("plans")
}

/// A customer organization (SME). Its data lives in the `schemaName` schema.
model Organization {
  id             Int                @id @default(autoincrement())
  /// Colombian NIT. Optional; unique when present.
  taxId          String?            @unique @map("tax_id") @db.VarChar(20)
  legalName      String             @map("legal_name") @db.VarChar(150)
  /// ISO 3166-1 alpha-2 code (e.g. `CO`).
  country        String             @db.Char(2)
  city           String             @db.VarChar(100)
  businessSector BusinessSector     @map("business_sector")
  teamSize       TeamSize           @map("team_size")
  productCount   ProductCount       @map("product_count")
  contactPhone   String?            @map("contact_phone") @db.VarChar(20)
  subdomain      String             @unique @db.VarChar(63)
  /// `tenant_` + subdomain with `-` replaced by `_`.
  schemaName     String             @unique @map("schema_name") @db.VarChar(63)
  /// Number of tenant migrations applied to `schemaName`.
  schemaVersion  Int                @default(0) @map("schema_version")
  status         OrganizationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions Subscription[]
  memberships   OrganizationMember[]

  @@map("organizations")
}

model Subscription {
  id             Int                @id @default(autoincrement())
  organizationId Int                @map("organization_id")
  planId         Int                @map("plan_id")
  startDate      DateTime           @map("start_date") @db.Date
  endDate        DateTime?          @map("end_date") @db.Date
  status         SubscriptionStatus @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([planId])
  @@map("subscriptions")
}

/// Login identity (Cognito). One account can belong to several organizations.
model Account {
  id         Int      @id @default(autoincrement())
  cognitoSub String   @unique @map("cognito_sub") @db.VarChar(64)
  email      String   @unique @db.VarChar(150)
  name       String   @db.VarChar(120)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  memberships OrganizationMember[]

  @@map("accounts")
}

/// Account ←→ organization (N:M). Every request must find an ACTIVE membership
/// before using the organization's tenant schema.
model OrganizationMember {
  accountId      Int              @map("account_id")
  organizationId Int              @map("organization_id")
  status         MembershipStatus @default(INVITED)
  /// Set when the invitation is accepted.
  joinedAt       DateTime?        @map("joined_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([accountId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}
